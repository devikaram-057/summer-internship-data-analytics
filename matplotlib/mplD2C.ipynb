   "source": [
    "import matplotlib.pyplot as plt\n",
    "days=[1, 2, 3, 4] \n",
    "visitors=[120, 150, 130, 180]\n",
    "plt.figure(figsize=(8, 4))\n",
    "plt.plot(days,visitors,marker='o', linestyle='--',color='blue')\n",
    "plt.xlabel(\"Day\")\n",
    "plt.ylabel(\"No of visitors\")\n",
    "plt.show()"
